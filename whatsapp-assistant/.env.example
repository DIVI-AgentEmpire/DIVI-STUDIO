# Copy this file to .env for local testing (npm run chat).
# On Vercel, add the same names under Project > Settings > Environment Variables.
# Never commit real values.

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b
GROQ_MODEL=

# --- WhatsApp Cloud API (Meta developer dashboard > your app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you invent; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Used to check that webhook calls really come from Meta.
WHATSAPP_APP_SECRET=
# Optional. Default: v23.0
GRAPH_API_VERSION=

# --- Human handover ---
# Your own WhatsApp number with country code, digits only (e.g. 919876543210).
# Must be added as a test recipient in Meta. Handover alerts go here.
OWNER_WHATSAPP_NUMBER=
# Optional. Minutes the bot stays quiet after handing a chat to a human. Default: 60
HANDOVER_MINUTES=

# --- Optional persistent storage (free Upstash Redis via Vercel Marketplace) ---
# Without these, data is kept in memory and can reset when Vercel restarts the function.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
